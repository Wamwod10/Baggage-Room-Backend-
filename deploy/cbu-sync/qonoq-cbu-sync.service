[Unit]
Description=Qonoq baggage signed Central Bank currency-rate synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=qonoq-fx
Group=qonoq-fx
WorkingDirectory=/opt/qonoq-baggage/backend
EnvironmentFile=/etc/qonoq-cbu-sync.env
ExecStart=/usr/bin/node /opt/qonoq-baggage/backend/scripts/cbuDomesticSync.js
TimeoutStartSec=50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
